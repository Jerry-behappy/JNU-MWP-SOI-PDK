<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>JNU internal Waveguide PCell startup registration</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>true</autorun-early>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text># -*- coding: utf-8 -*-
# 创建者: Junyi Zhang
# 时间: 2026-08

# 该早期宏仅负责内部 Waveguide PCell 的恢复注册。它必须早于用户 GDS
# 解析执行，保证写入 GDS 的 PCell 参数能重新关联，而不会退化为 $N cell。
import os
import sys

_PYMACROS_DIR = os.path.dirname(os.path.abspath(__file__))
if _PYMACROS_DIR not in sys.path:
    sys.path.insert(0, _PYMACROS_DIR)

from JNU_MWP_tools.core.internal_waveguide_registry import (
    install_internal_waveguide_registration,
)

install_internal_waveguide_registration()
</text>
</klayout-macro>
