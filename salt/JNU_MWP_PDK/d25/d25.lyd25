<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description/>
 <version/>
 <category>d25</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>false</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name>d25_scripts</group-name>
 <menu-path>tools_menu.d25.end</menu-path>
 <interpreter>dsl</interpreter>
 <dsl-interpreter-name>d25-dsl-xml</dsl-interpreter-name>
 <text>#################
# SOI 2.5D View 渲染脚本
#################

# z 坐标约定：
# z = 0      ：BOX 上表面，也是硅器件层底面
# z &gt; 0      ：硅波导、加热器、金属布线方向
# z &lt; 0      ：BOX 和硅衬底方向
#
# 本脚本用于 2.5D 可视化渲染，不代表真实工艺形貌。
# 它主要用来检查：硅层高度、浅刻蚀区域、深槽隔离、金属层堆叠关系。

#################
# 图层定义
#################

LayerSi          = input(1, 0)       # 完整 220 nm 硅层，例如全刻蚀波导、光栅齿、耦合区
LayerSi_rib      = input(2, 0)       # 浅刻蚀 rib/slab 区域，220 nm 硅刻蚀 70 nm 后剩余 150 nm

LayerM1          = input(11, 0)      # M1 金属层，作为加热电极显示，厚度 200 nm
LayerM2          = input(12, 0)      # M2 金属层，作为上层布线显示，厚度 200 nm

LayerFP          = input(99)         # 版图边界 / floor plan，用来定义 BOX 和衬底的横向范围
LayerDeepTrench  = input(40, 0)      # 深槽隔离区域，从表面向下挖到 z = -5 um

#################
# 布尔处理
#################

# 220 nm 全高度硅区域。
# 如果 LayerSi_rib 与 LayerSi 重叠，这里把 rib 区从完整硅层里扣掉，
# 避免同一 XY 位置同时生成 220 nm 和 150 nm 两块硅。
Si_220 = LayerSi - LayerSi_rib

# 150 nm 浅刻蚀硅区域。
Si_150 = LayerSi_rib

# 有效深槽区域只取版图边界内部。
# 这样边界外的 trench 图形不会影响 BOX/衬底的渲染。
DeepTrench = LayerDeepTrench &amp; LayerFP

# BOX 区域：深槽贯穿 BOX，所以 BOX 需要扣除 trench。
BOX_area = LayerFP - DeepTrench

# 衬底上部：深槽继续进入衬底 2 um，因此 z = -5 um 到 -3 um 也扣除 trench。
Substrate_top_area = LayerFP - DeepTrench

# 衬底底部：深槽只到 z = -5 um，更深处保持完整。
Substrate_bottom_area = LayerFP

#################
# 衬底与 BOX
#################

z(Substrate_bottom_area,
  zstart: -13.um,
  zstop: -5.um,
  color: 0x5a5a5a,
  name: "Si substrate bottom"
)

z(Substrate_top_area,
  zstart: -5.um,
  zstop: -3.um,
  color: 0x5a5a5a,
  name: "Si substrate trenched"
)

z(BOX_area,
  zstart: -3.um,
  zstop: 0.um,
  color: 0xd8d8d2,
  name: "BOX 3um"
)

#################
# 硅波导层
#################

zz(name: "Silicon waveguide", color: 0x8b3a2e) do
  # 完整硅波导：0 到 220 nm
  z(Si_220, zstart: 0.nm, zstop: 220.nm)

  # 浅刻蚀 rib/slab：0 到 150 nm
  z(Si_150, zstart: 0.nm, zstop: 150.nm)
end

#################
# 金属层
#################

z(LayerM1,
  zstart: 240.nm,
  zstop: 440.nm,
  color: 0xd99000,
  name: "M1 heater 200nm"
)

z(LayerM2,
  zstart: 440.nm,
  zstop: 640.nm,
  color: 0xffd34d,
  name: "M2 routing 200nm"
)</text>
</klayout-macro>
